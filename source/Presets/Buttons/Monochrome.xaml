<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova button preset: Monochrome-->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#4a4f58" />
    <SolidColorBrush x:Key="ButtonIsMouseOverBackgroundBrush" Color="#5c6270" />
    <SolidColorBrush x:Key="ContextButtonBackgroundBrush" Color="#4a4f58" />
    <SolidColorBrush x:Key="ContextButtonIsMouseOverBackgroundBrush" Color="#5c6270" />
    <SolidColorBrush x:Key="PlayButtonBackgroundBrush" Color="#59606b" />
    <SolidColorBrush x:Key="PlayButtonIsMouseOverBackgroundBrush" Color="#6b7381" />
    <SolidColorBrush x:Key="MoreButtonInstalledBackgroundBrush" Color="#4a4f58" />
    <SolidColorBrush x:Key="MoreButtonInstalledIsMouseOverBackgroundBrush" Color="#5c6270" />
    <SolidColorBrush x:Key="MoreButtonNotInstalledBackgroundBrush" Color="#3f444c" />
    <SolidColorBrush x:Key="MoreButtonNotInstalledIsMouseOverBackgroundBrush" Color="#525863" />

</ResourceDictionary>
