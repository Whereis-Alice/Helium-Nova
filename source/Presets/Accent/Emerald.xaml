<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova accent preset: Emerald / 强调色预设：翠绿-->
    <!--Core colours are hand tuned. Every other key is hue rotated from the Helium 1.71 Azure-->
    <!--baseline (hue 205.2, sat 1.000) to hue 145.4 with saturation factor 0.632.-->
    <!--核心色为手调，其余色由 Helium 原生蓝色基准按色相旋转生成。-->

    <!--region Core accent colours / 核心强调色-->
    <Color x:Key="GlyphColor">#2ecc71</Color>
    <Color x:Key="GlyphSubColor">#27b263</Color>
    <Color x:Key="HighlightGlyphColor">#88A8F0C4</Color>
    <Color x:Key="HoverColor">#1f8a4d</Color>
    <!--region end-->

    <!--region Tinted surface colours / 色调表面色-->
    <Color x:Key="MainColor">#375C47</Color>
    <Color x:Key="BackgroundToneColor">#375C47</Color>
    <Color x:Key="PopupBorderColor">#4B775E</Color>
    <!--region end-->

    <!--region Solid accent brushes / 强调纯色笔刷-->
    <SolidColorBrush x:Key="NormalBrush" Color="#55A8F0C4" />
    <SolidColorBrush x:Key="TabControlSeparatorBrush" Color="#55A8F0C4" />
    <SolidColorBrush x:Key="LibraryDetailsViewIsLaunchingForegroundBrush" Color="#2ecc71" />
    <SolidColorBrush x:Key="MoreButtonNotInstalledBackgroundBrush" Color="#43AF71" />
    <SolidColorBrush x:Key="ExpanderExIsMouseOverBackgroundBrush" Color="#466151" />
    <SolidColorBrush x:Key="DetailsViewItemIsSelectedBackgroundBrush" Color="#466151" />
    <SolidColorBrush x:Key="DetailsViewItemIsMouseOverInstalledBackgroundBrush" Color="#638B74" />
    <!--region end-->

    <!--region Gradient accent brushes / 强调渐变笔刷-->
    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#5ACB8A" Offset="0"/>
        <GradientStop Color="#4AB879" Offset="0.75"/>
        <GradientStop Color="#43AF71" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#69DC9A" Offset="0"/>
        <GradientStop Color="#58C988" Offset="0.75"/>
        <GradientStop Color="#50C080" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#5ACB8A" Offset="0"/>
        <GradientStop Color="#4AB879" Offset="0.75"/>
        <GradientStop Color="#43AF71" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#69DC9A" Offset="0"/>
        <GradientStop Color="#58C988" Offset="0.75"/>
        <GradientStop Color="#50C080" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MoreButtonNotInstalledIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#69DA99" Offset="0"/>
        <GradientStop Color="#5BCD8B" Offset="0.50"/>
        <GradientStop Color="#53C282" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GridItemBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#27A05A" Offset="0"/>
        <GradientStop Color="#3D9F67" Offset="0.5"/>
        <GradientStop Color="#479C6B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBarBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#479C6B" Offset="0"/>
        <GradientStop Color="#3D9F67" Offset="0.5"/>
        <GradientStop Color="#27A05A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StandardWindowBorderBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#2FD073" Offset="0"/>
        <GradientStop Color="#59D98F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlsIconsGlyphBrush" MappingMode="RelativeToBoundingBox" StartPoint="0.0, 0.0" EndPoint="1.0, 1.0">
        <GradientStop Color="#2FD073" Offset="0"/>
        <GradientStop Color="#54D88C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenusHoverBrush" StartPoint="0.0, 0.5" EndPoint="1.0, 0.5">
        <GradientStop Color="#456854" Offset="0"/>
        <GradientStop Color="#456653" Offset="0.5"/>
        <GradientStop Color="#40614E" Offset="1"/>
    </LinearGradientBrush>
    <!--region end-->

</ResourceDictionary>
