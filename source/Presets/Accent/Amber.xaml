<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova accent preset: Amber / 强调色预设：琥珀-->
    <!--Core colours are hand tuned. Every other key is hue rotated from the Helium 1.71 Azure-->
    <!--baseline (hue 205.2, sat 1.000) to hue 42.1 with saturation factor 1.000.-->
    <!--核心色为手调，其余色由 Helium 原生蓝色基准按色相旋转生成。-->

    <!--region Core accent colours / 核心强调色-->
    <Color x:Key="GlyphColor">#ffb300</Color>
    <Color x:Key="GlyphSubColor">#f0a300</Color>
    <Color x:Key="HighlightGlyphColor">#88FFD98A</Color>
    <Color x:Key="HoverColor">#c98d00</Color>
    <!--region end-->

    <!--region Tinted surface colours / 色调表面色-->
    <Color x:Key="MainColor">#67552C</Color>
    <Color x:Key="BackgroundToneColor">#67552C</Color>
    <Color x:Key="PopupBorderColor">#846F3E</Color>
    <!--region end-->

    <!--region Solid accent brushes / 强调纯色笔刷-->
    <SolidColorBrush x:Key="NormalBrush" Color="#55FFD98A" />
    <SolidColorBrush x:Key="TabControlSeparatorBrush" Color="#55FFD98A" />
    <SolidColorBrush x:Key="LibraryDetailsViewIsLaunchingForegroundBrush" Color="#ffb300" />
    <SolidColorBrush x:Key="MoreButtonNotInstalledBackgroundBrush" Color="#CF9C23" />
    <SolidColorBrush x:Key="ExpanderExIsMouseOverBackgroundBrush" Color="#695C3E" />
    <SolidColorBrush x:Key="DetailsViewItemIsSelectedBackgroundBrush" Color="#695C3E" />
    <SolidColorBrush x:Key="DetailsViewItemIsMouseOverInstalledBackgroundBrush" Color="#968458" />
    <!--region end-->

    <!--region Gradient accent brushes / 强调渐变笔刷-->
    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#ECB739" Offset="0"/>
        <GradientStop Color="#D8A42A" Offset="0.75"/>
        <GradientStop Color="#CF9C23" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#FEC747" Offset="0"/>
        <GradientStop Color="#EAB537" Offset="0.75"/>
        <GradientStop Color="#E0AC30" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#ECB739" Offset="0"/>
        <GradientStop Color="#D8A42A" Offset="0.75"/>
        <GradientStop Color="#CF9C23" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#FEC747" Offset="0"/>
        <GradientStop Color="#EAB537" Offset="0.75"/>
        <GradientStop Color="#E0AC30" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MoreButtonNotInstalledIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#FBC648" Offset="0"/>
        <GradientStop Color="#EEB83A" Offset="0.50"/>
        <GradientStop Color="#E3AE32" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GridItemBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#C38A04" Offset="0"/>
        <GradientStop Color="#BB8D21" Offset="0.5"/>
        <GradientStop Color="#B58D2E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBarBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#B58D2E" Offset="0"/>
        <GradientStop Color="#BB8D21" Offset="0.5"/>
        <GradientStop Color="#C38A04" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StandardWindowBorderBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#FFB300" Offset="0"/>
        <GradientStop Color="#FFC233" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlsIconsGlyphBrush" MappingMode="RelativeToBoundingBox" StartPoint="0.0, 0.0" EndPoint="1.0, 1.0">
        <GradientStop Color="#FFB300" Offset="0"/>
        <GradientStop Color="#FFC02D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenusHoverBrush" StartPoint="0.0, 0.5" EndPoint="1.0, 0.5">
        <GradientStop Color="#72623B" Offset="0"/>
        <GradientStop Color="#70603B" Offset="0.5"/>
        <GradientStop Color="#6A5B37" Offset="1"/>
    </LinearGradientBrush>
    <!--region end-->

</ResourceDictionary>
