<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova accent preset: Cyan / 强调色预设：青绿-->
    <!--Core colours are hand tuned. Every other key is hue rotated from the Helium 1.71 Azure-->
    <!--baseline (hue 205.2, sat 1.000) to hue 184.2 with saturation factor 1.000.-->
    <!--核心色为手调，其余色由 Helium 原生蓝色基准按色相旋转生成。-->

    <!--region Core accent colours / 核心强调色-->
    <Color x:Key="GlyphColor">#00c8d7</Color>
    <Color x:Key="GlyphSubColor">#00b4c4</Color>
    <Color x:Key="HighlightGlyphColor">#8855E0EA</Color>
    <Color x:Key="HoverColor">#128a95</Color>
    <!--region end-->

    <!--region Tinted surface colours / 色调表面色-->
    <Color x:Key="MainColor">#2C6367</Color>
    <Color x:Key="BackgroundToneColor">#2C6367</Color>
    <Color x:Key="PopupBorderColor">#3E7F84</Color>
    <!--region end-->

    <!--region Solid accent brushes / 强调纯色笔刷-->
    <SolidColorBrush x:Key="NormalBrush" Color="#5555E0EA" />
    <SolidColorBrush x:Key="TabControlSeparatorBrush" Color="#5555E0EA" />
    <SolidColorBrush x:Key="LibraryDetailsViewIsLaunchingForegroundBrush" Color="#00c8d7" />
    <SolidColorBrush x:Key="MoreButtonNotInstalledBackgroundBrush" Color="#23C3CF" />
    <SolidColorBrush x:Key="ExpanderExIsMouseOverBackgroundBrush" Color="#3E6669" />
    <SolidColorBrush x:Key="DetailsViewItemIsSelectedBackgroundBrush" Color="#3E6669" />
    <SolidColorBrush x:Key="DetailsViewItemIsMouseOverInstalledBackgroundBrush" Color="#589296" />
    <!--region end-->

    <!--region Gradient accent brushes / 强调渐变笔刷-->
    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#39E0EC" Offset="0"/>
        <GradientStop Color="#2ACCD8" Offset="0.75"/>
        <GradientStop Color="#23C3CF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#47F1FE" Offset="0"/>
        <GradientStop Color="#37DEEA" Offset="0.75"/>
        <GradientStop Color="#30D4E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#39E0EC" Offset="0"/>
        <GradientStop Color="#2ACCD8" Offset="0.75"/>
        <GradientStop Color="#23C3CF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#47F1FE" Offset="0"/>
        <GradientStop Color="#37DEEA" Offset="0.75"/>
        <GradientStop Color="#30D4E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MoreButtonNotInstalledIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#48EFFB" Offset="0"/>
        <GradientStop Color="#3AE1EE" Offset="0.50"/>
        <GradientStop Color="#32D7E3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GridItemBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#04B6C3" Offset="0"/>
        <GradientStop Color="#21B0BB" Offset="0.5"/>
        <GradientStop Color="#2EACB5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBarBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#2EACB5" Offset="0"/>
        <GradientStop Color="#21B0BB" Offset="0.5"/>
        <GradientStop Color="#04B6C3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StandardWindowBorderBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#00EDFF" Offset="0"/>
        <GradientStop Color="#33F1FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlsIconsGlyphBrush" MappingMode="RelativeToBoundingBox" StartPoint="0.0, 0.0" EndPoint="1.0, 1.0">
        <GradientStop Color="#00EDFF" Offset="0"/>
        <GradientStop Color="#2DF0FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenusHoverBrush" StartPoint="0.0, 0.5" EndPoint="1.0, 0.5">
        <GradientStop Color="#3B6E72" Offset="0"/>
        <GradientStop Color="#3B6C70" Offset="0.5"/>
        <GradientStop Color="#37666A" Offset="1"/>
    </LinearGradientBrush>
    <!--region end-->

</ResourceDictionary>
