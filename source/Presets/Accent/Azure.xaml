<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova accent preset: Azure / 强调色预设：天青蓝-->
    <!--This is the stock Helium 1.71 accent surface, restated so that switching back is lossless.-->
    <!--此预设完全等同于 Helium 1.71 原生配色，用于无损还原。-->

    <!--region Core accent colours / 核心强调色-->
    <Color x:Key="GlyphColor">#1a9fff</Color>
    <Color x:Key="GlyphSubColor">#1E92FF</Color>
    <Color x:Key="HighlightGlyphColor">#8855CDFF</Color>
    <Color x:Key="HoverColor">#247BA0</Color>
    <!--region end-->

    <!--region Tinted surface colours / 色调表面色-->
    <Color x:Key="MainColor">#2C3A67</Color>
    <Color x:Key="BackgroundToneColor">#2C3A67</Color>
    <Color x:Key="PopupBorderColor">#3e6184</Color>
    <!--region end-->

    <!--region Solid accent brushes / 强调纯色笔刷-->
    <SolidColorBrush x:Key="NormalBrush" Color="#5555CDFF" />
    <SolidColorBrush x:Key="TabControlSeparatorBrush" Color="#5555CDFF" />
    <SolidColorBrush x:Key="LibraryDetailsViewIsLaunchingForegroundBrush" Color="#1a9fff" />
    <SolidColorBrush x:Key="MoreButtonNotInstalledBackgroundBrush" Color="#235ECF" />
    <SolidColorBrush x:Key="ExpanderExIsMouseOverBackgroundBrush" Color="#3E4E69" />
    <SolidColorBrush x:Key="DetailsViewItemIsSelectedBackgroundBrush" Color="#3E4E69" />
    <SolidColorBrush x:Key="DetailsViewItemIsMouseOverInstalledBackgroundBrush" Color="#586F96" />
    <!--region end-->

    <!--region Gradient accent brushes / 强调渐变笔刷-->
    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#399AEC" Offset="0"/>
        <GradientStop Color="#2A71D8" Offset="0.75"/>
        <GradientStop Color="#235ECF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#47BDFE" Offset="0"/>
        <GradientStop Color="#3794EA" Offset="0.75"/>
        <GradientStop Color="#3081E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#399AEC" Offset="0"/>
        <GradientStop Color="#2A71D8" Offset="0.75"/>
        <GradientStop Color="#235ECF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#47BDFE" Offset="0"/>
        <GradientStop Color="#3794EA" Offset="0.75"/>
        <GradientStop Color="#3081E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MoreButtonNotInstalledIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#48b8fb" Offset="0"/>
        <GradientStop Color="#3a9eee" Offset="0.50"/>
        <GradientStop Color="#3287e3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GridItemBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#049BC3" Offset="0"/>
        <GradientStop Color="#217BBB" Offset="0.5"/>
        <GradientStop Color="#2E52B5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBarBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#2E52B5" Offset="0"/>
        <GradientStop Color="#217BBB" Offset="0.5"/>
        <GradientStop Color="#049BC3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StandardWindowBorderBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#00ccff" Offset="0"/>
        <GradientStop Color="#3366ff" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlsIconsGlyphBrush" MappingMode="RelativeToBoundingBox" StartPoint="0.0, 0.0" EndPoint="1.0, 1.0">
        <GradientStop Color="#00CCFF" Offset="0"/>
        <GradientStop Color="#2D73FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenusHoverBrush" StartPoint="0.0, 0.5" EndPoint="1.0, 0.5">
        <GradientStop Color="#3B5C72" Offset="0"/>
        <GradientStop Color="#3B5670" Offset="0.5"/>
        <GradientStop Color="#374C6A" Offset="1"/>
    </LinearGradientBrush>
    <!--region end-->

</ResourceDictionary>
