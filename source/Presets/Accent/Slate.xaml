<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova accent preset: Slate / 强调色预设：石墨灰-->
    <!--Core colours are hand tuned. Every other key is hue rotated from the Helium 1.71 Azure-->
    <!--baseline (hue 205.2, sat 1.000) to hue 213.9 with saturation factor 0.258.-->
    <!--核心色为手调，其余色由 Helium 原生蓝色基准按色相旋转生成。-->

    <!--region Core accent colours / 核心强调色-->
    <Color x:Key="GlyphColor">#8fa3bd</Color>
    <Color x:Key="GlyphSubColor">#7e91aa</Color>
    <Color x:Key="HighlightGlyphColor">#88C3D2E3</Color>
    <Color x:Key="HoverColor">#66788c</Color>
    <!--region end-->

    <!--region Tinted surface colours / 色调表面色-->
    <Color x:Key="MainColor">#424951</Color>
    <Color x:Key="BackgroundToneColor">#424951</Color>
    <Color x:Key="PopupBorderColor">#58606A</Color>
    <!--region end-->

    <!--region Solid accent brushes / 强调纯色笔刷-->
    <SolidColorBrush x:Key="NormalBrush" Color="#55C3D2E3" />
    <SolidColorBrush x:Key="TabControlSeparatorBrush" Color="#55C3D2E3" />
    <SolidColorBrush x:Key="LibraryDetailsViewIsLaunchingForegroundBrush" Color="#8fa3bd" />
    <SolidColorBrush x:Key="MoreButtonNotInstalledBackgroundBrush" Color="#63768F" />
    <SolidColorBrush x:Key="ExpanderExIsMouseOverBackgroundBrush" Color="#4E5359" />
    <SolidColorBrush x:Key="DetailsViewItemIsSelectedBackgroundBrush" Color="#4E5359" />
    <SolidColorBrush x:Key="DetailsViewItemIsMouseOverInstalledBackgroundBrush" Color="#6F767F" />
    <!--region end-->

    <!--region Gradient accent brushes / 强调渐变笔刷-->
    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#7B8FAA" Offset="0"/>
        <GradientStop Color="#6B7E97" Offset="0.75"/>
        <GradientStop Color="#63768F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#8B9FBA" Offset="0"/>
        <GradientStop Color="#798DA8" Offset="0.75"/>
        <GradientStop Color="#71859F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#7B8FAA" Offset="0"/>
        <GradientStop Color="#6B7E97" Offset="0.75"/>
        <GradientStop Color="#63768F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextButtonIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#8B9FBA" Offset="0"/>
        <GradientStop Color="#798DA8" Offset="0.75"/>
        <GradientStop Color="#71859F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MoreButtonNotInstalledIsMouseOverBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#8A9EB9" Offset="0"/>
        <GradientStop Color="#7D91AB" Offset="0.50"/>
        <GradientStop Color="#7488A1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GridItemBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#4B607C" Offset="0"/>
        <GradientStop Color="#5A6B82" Offset="0.5"/>
        <GradientStop Color="#606F83" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBarBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#606F83" Offset="0"/>
        <GradientStop Color="#5A6B82" Offset="0.5"/>
        <GradientStop Color="#4B607C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StandardWindowBorderBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#5F7BA0" Offset="0"/>
        <GradientStop Color="#7F96B3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlsIconsGlyphBrush" MappingMode="RelativeToBoundingBox" StartPoint="0.0, 0.0" EndPoint="1.0, 1.0">
        <GradientStop Color="#5F7BA0" Offset="0"/>
        <GradientStop Color="#7B92B1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenusHoverBrush" StartPoint="0.0, 0.5" EndPoint="1.0, 0.5">
        <GradientStop Color="#4F565E" Offset="0"/>
        <GradientStop Color="#4F555C" Offset="0.5"/>
        <GradientStop Color="#4A5057" Offset="1"/>
    </LinearGradientBrush>
    <!--region end-->

</ResourceDictionary>
