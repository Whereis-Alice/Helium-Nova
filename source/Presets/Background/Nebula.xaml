<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova background preset: Nebula-->
    <LinearGradientBrush x:Key="WindowBackgourndBrush1" StartPoint="0.5,-0.2" EndPoint="0.4,1">
        <GradientStop Color="#2a2440" Offset="0" />
        <GradientStop Color="#2a2440" Offset="0.4" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WindowBackgourndBrush" GradientOrigin="0.57,0.37" Center="0.5,0.5" RadiusX="1" RadiusY="1">
        <GradientStop Color="#3a2f5c" Offset="0.0" />
        <GradientStop Color="#141021" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="StandardWindowBackgroundBrush" GradientOrigin="0.0,0.0" Center="0.0,0.0" RadiusX="1" RadiusY="1">
        <GradientStop Color="#3a3350" Offset="-0.1" />
        <GradientStop Color="#26212e" Offset="1.1" />
    </RadialGradientBrush>

    <!--Surface chrome: the keys that actually paint the top panel, sidebar, game list,
        list group headers, menus and controls. Hue-rotated to 254.7 deg with
        lightness preserved, so text contrast is unchanged.-->
    <Color x:Key="PopupBackgroundColor">#19132A</Color>
    <Color x:Key="GridItemBackgroundColor">#3F3855</Color>
    <Color x:Key="PanelSeparatorColor">#17151D</Color>
    <Color x:Key="ControlBackgroundColor">#3D384D</Color>
    <Color x:Key="ControlBackgroundColorDarker">#26232F</Color>
    <Color x:Key="ControlBackgroundColorDark">#99201D28</Color>
    <Color x:Key="ControlBackgroundColorDarkHover">#3D384D</Color>

    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="#181329" />
    <SolidColorBrush x:Key="LibraryDetailsViewBackgroundBrush" Color="#252132" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="#2A2636" />
    <SolidColorBrush x:Key="TreeViewBackgroundBrush" Color="#2B2737" />
    <SolidColorBrush x:Key="FilterPanelViewBackgroundBrush" Color="#4C4660" />
    <SolidColorBrush x:Key="GroupCountBackgroundBrush" Color="#423D53" />
    <SolidColorBrush x:Key="GridViewCoverSubtitleBackgroundBrush" Color="#3F3855" />
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#201D28" />
    <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#625A7A" />
    <SolidColorBrush x:Key="ThumbIsMouseOverBackgroundBrush" Color="#7D7499" />
    <SolidColorBrush x:Key="DetailsViewItemIsMouseOverBackgroundBrush" Color="#352B52" />

    <LinearGradientBrush x:Key="ExpanderExBackgroundBrush" StartPoint="0, 0.5" EndPoint="1.0, 0.5">
        <GradientStop Color="#2B2440" Offset="0.4" />
        <GradientStop Color="#272238" Offset="0.75" />
        <GradientStop Color="#252132" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MenuBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#534C68" Offset="0" />
        <GradientStop Color="#534C68" Offset="0.5" />
        <GradientStop Color="#605878" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="PopupBackgroundBrush" GradientOrigin="0.5,0.0" Center="0.5,0.0" RadiusX="1" RadiusY="1">
        <GradientStop Color="#3C374C" Offset="0.0" />
        <GradientStop Color="#3C374C" Offset="0.5" />
        <GradientStop Color="#342F41" Offset="1.0" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TrayContextMenuBackgroundBrush1" StartPoint="0.5, 0.0" EndPoint="0.5, 1.0">
        <GradientStop Color="#1E1C26" Offset="0" />
        <GradientStop Color="#1E1C26" Offset="0.5" />
        <GradientStop Color="#1E1C26" Offset="1" />
    </LinearGradientBrush>
    <!--Surface chrome end-->
</ResourceDictionary>
