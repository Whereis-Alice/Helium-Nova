<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova background preset: Forest-->
    <LinearGradientBrush x:Key="WindowBackgourndBrush1" StartPoint="0.5,-0.2" EndPoint="0.4,1">
        <GradientStop Color="#1c2b22" Offset="0" />
        <GradientStop Color="#1c2b22" Offset="0.4" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WindowBackgourndBrush" GradientOrigin="0.57,0.37" Center="0.5,0.5" RadiusX="1" RadiusY="1">
        <GradientStop Color="#23392c" Offset="0.0" />
        <GradientStop Color="#0c150f" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="StandardWindowBackgroundBrush" GradientOrigin="0.0,0.0" Center="0.0,0.0" RadiusX="1" RadiusY="1">
        <GradientStop Color="#263a2d" Offset="-0.1" />
        <GradientStop Color="#1a271f" Offset="1.1" />
    </RadialGradientBrush>

</ResourceDictionary>
