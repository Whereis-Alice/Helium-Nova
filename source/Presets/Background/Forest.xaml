<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova background preset: Forest-->
    <LinearGradientBrush x:Key="WindowBackgourndBrush1" StartPoint="0.5,-0.2" EndPoint="0.4,1">
        <GradientStop Color="#1c2b22" Offset="0" />
        <GradientStop Color="#1c2b22" Offset="0.4" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WindowBackgourndBrush" GradientOrigin="0.57,0.37" Center="0.5,0.5" RadiusX="1" RadiusY="1">
        <GradientStop Color="#23392c" Offset="0.0" />
        <GradientStop Color="#0c150f" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="StandardWindowBackgroundBrush" GradientOrigin="0.0,0.0" Center="0.0,0.0" RadiusX="1" RadiusY="1">
        <GradientStop Color="#263a2d" Offset="-0.1" />
        <GradientStop Color="#1a271f" Offset="1.1" />
    </RadialGradientBrush>

    <!--Surface chrome: the keys that actually paint the top panel, sidebar, game list,
        list group headers, menus and controls. Hue-rotated to 144.5 deg with
        lightness preserved, so text contrast is unchanged.-->
    <Color x:Key="PopupBackgroundColor">#14291D</Color>
    <Color x:Key="GridItemBackgroundColor">#3A5344</Color>
    <Color x:Key="PanelSeparatorColor">#161C18</Color>
    <Color x:Key="ControlBackgroundColor">#3A4B41</Color>
    <Color x:Key="ControlBackgroundColorDarker">#232F28</Color>
    <Color x:Key="ControlBackgroundColorDark">#991E2722</Color>
    <Color x:Key="ControlBackgroundColorDarkHover">#3A4B41</Color>

    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="#15271C" />
    <SolidColorBrush x:Key="LibraryDetailsViewBackgroundBrush" Color="#223128" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="#27352D" />
    <SolidColorBrush x:Key="TreeViewBackgroundBrush" Color="#28362E" />
    <SolidColorBrush x:Key="FilterPanelViewBackgroundBrush" Color="#485E51" />
    <SolidColorBrush x:Key="GroupCountBackgroundBrush" Color="#3E5246" />
    <SolidColorBrush x:Key="GridViewCoverSubtitleBackgroundBrush" Color="#3A5344" />
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#1E2722" />
    <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#5C7867" />
    <SolidColorBrush x:Key="ThumbIsMouseOverBackgroundBrush" Color="#769784" />
    <SolidColorBrush x:Key="DetailsViewItemIsMouseOverBackgroundBrush" Color="#2E4F3B" />

    <LinearGradientBrush x:Key="ExpanderExBackgroundBrush" StartPoint="0, 0.5" EndPoint="1.0, 0.5">
        <GradientStop Color="#263E30" Offset="0.4" />
        <GradientStop Color="#24362B" Offset="0.75" />
        <GradientStop Color="#223128" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MenuBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#4E6658" Offset="0" />
        <GradientStop Color="#4E6658" Offset="0.5" />
        <GradientStop Color="#5A7665" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="PopupBackgroundBrush" GradientOrigin="0.5,0.0" Center="0.5,0.0" RadiusX="1" RadiusY="1">
        <GradientStop Color="#394A40" Offset="0.0" />
        <GradientStop Color="#394A40" Offset="0.5" />
        <GradientStop Color="#304037" Offset="1.0" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TrayContextMenuBackgroundBrush1" StartPoint="0.5, 0.0" EndPoint="0.5, 1.0">
        <GradientStop Color="#1D2520" Offset="0" />
        <GradientStop Color="#1D2520" Offset="0.5" />
        <GradientStop Color="#1D2520" Offset="1" />
    </LinearGradientBrush>
    <!--Surface chrome end-->
</ResourceDictionary>
