<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Helium Nova background preset: Ocean-->
    <LinearGradientBrush x:Key="WindowBackgourndBrush1" StartPoint="0.5,-0.2" EndPoint="0.4,1">
        <GradientStop Color="#17303d" Offset="0" />
        <GradientStop Color="#17303d" Offset="0.4" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WindowBackgourndBrush" GradientOrigin="0.57,0.37" Center="0.5,0.5" RadiusX="1" RadiusY="1">
        <GradientStop Color="#1d4152" Offset="0.0" />
        <GradientStop Color="#0a1720" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="StandardWindowBackgroundBrush" GradientOrigin="0.0,0.0" Center="0.0,0.0" RadiusX="1" RadiusY="1">
        <GradientStop Color="#21414f" Offset="-0.1" />
        <GradientStop Color="#162b34" Offset="1.1" />
    </RadialGradientBrush>

    <!--Surface chrome: the keys that actually paint the top panel, sidebar, game list,
        list group headers, menus and controls. Hue-rotated to 199.2 deg with
        lightness preserved, so text contrast is unchanged.-->
    <Color x:Key="PopupBackgroundColor">#0F242E</Color>
    <Color x:Key="GridItemBackgroundColor">#344D5A</Color>
    <Color x:Key="PanelSeparatorColor">#141B1E</Color>
    <Color x:Key="ControlBackgroundColor">#354750</Color>
    <Color x:Key="ControlBackgroundColorDarker">#212C31</Color>
    <Color x:Key="ControlBackgroundColorDark">#991C2529</Color>
    <Color x:Key="ControlBackgroundColorDarkHover">#354750</Color>

    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="#10232C" />
    <SolidColorBrush x:Key="LibraryDetailsViewBackgroundBrush" Color="#1E2D35" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="#243238" />
    <SolidColorBrush x:Key="TreeViewBackgroundBrush" Color="#253339" />
    <SolidColorBrush x:Key="FilterPanelViewBackgroundBrush" Color="#425964" />
    <SolidColorBrush x:Key="GroupCountBackgroundBrush" Color="#3A4D56" />
    <SolidColorBrush x:Key="GridViewCoverSubtitleBackgroundBrush" Color="#344D5A" />
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#1C2529" />
    <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#55727F" />
    <SolidColorBrush x:Key="ThumbIsMouseOverBackgroundBrush" Color="#6E8F9F" />
    <SolidColorBrush x:Key="DetailsViewItemIsMouseOverBackgroundBrush" Color="#264758" />

    <LinearGradientBrush x:Key="ExpanderExBackgroundBrush" StartPoint="0, 0.5" EndPoint="1.0, 0.5">
        <GradientStop Color="#203844" Offset="0.4" />
        <GradientStop Color="#1F323B" Offset="0.75" />
        <GradientStop Color="#1E2D35" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MenuBackgroundBrush" StartPoint="0.0, 0.0" EndPoint="1.0, 0.0">
        <GradientStop Color="#48606C" Offset="0" />
        <GradientStop Color="#48606C" Offset="0.5" />
        <GradientStop Color="#536F7D" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="PopupBackgroundBrush" GradientOrigin="0.5,0.0" Center="0.5,0.0" RadiusX="1" RadiusY="1">
        <GradientStop Color="#34464F" Offset="0.0" />
        <GradientStop Color="#34464F" Offset="0.5" />
        <GradientStop Color="#2D3C43" Offset="1.0" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TrayContextMenuBackgroundBrush1" StartPoint="0.5, 0.0" EndPoint="0.5, 1.0">
        <GradientStop Color="#1A2328" Offset="0" />
        <GradientStop Color="#1A2328" Offset="0.5" />
        <GradientStop Color="#1A2328" Offset="1" />
    </LinearGradientBrush>
    <!--Surface chrome end-->
</ResourceDictionary>
